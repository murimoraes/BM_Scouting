{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmscouting.invalid/contracts/v1/tracks.schema.json",
  "title": "tracks v1",
  "description": "Saída do módulo tracking (Tracking/ReID): tracklets brutos do tracker e reconexões (links) que os agrupam em global_id. Consumido por identity e field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "tracker", "tracklets", "links"],
  "properties": {
    "header": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/header"},
        {"properties": {"schema_name": {"const": "tracks"}}}
      ]
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "params"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "params": {"type": "object"}
      }
    },
    "tracklets": {
      "type": "array",
      "items": {"$ref": "#/$defs/tracklet"}
    },
    "links": {
      "description": "Arestas de reconexão entre tracklets (fragmentação). Vazio se não houve reconexão.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_tracklet_id", "to_tracklet_id", "score", "method"],
        "properties": {
          "from_tracklet_id": {"type": "integer", "minimum": 0},
          "to_tracklet_id": {"type": "integer", "minimum": 0},
          "score": {"$ref": "common.schema.json#/$defs/confidence"},
          "method": {"enum": ["spatiotemporal", "appearance", "jersey_number", "human"]}
        }
      }
    }
  },
  "$defs": {
    "tracklet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracklet_id", "global_id", "class", "start_frame", "end_frame", "observations"],
      "properties": {
        "tracklet_id": {"type": "integer", "minimum": 0},
        "global_id": {
          "description": "Identidade após reconexão; null se o tracklet não foi agrupado.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "class": {"$ref": "common.schema.json#/$defs/object_class"},
        "start_frame": {"$ref": "common.schema.json#/$defs/frame_index"},
        "end_frame": {"$ref": "common.schema.json#/$defs/frame_index"},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame_index", "bbox_xyxy", "confidence", "interpolated"],
            "properties": {
              "frame_index": {"$ref": "common.schema.json#/$defs/frame_index"},
              "bbox_xyxy": {"$ref": "common.schema.json#/$defs/bbox_xyxy"},
              "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
              "interpolated": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
